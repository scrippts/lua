--// PERCENTAGE
local percent = Instance.new("TextLabel")
percent.Size = UDim2.new(1, -50, 0, 30)
percent.Position = UDim2.new(0, 25, 0, 143)
percent.BackgroundTransparency = 1
percent.Text = "0%"
percent.TextColor3 = Color3.fromRGB(225, 210, 255)
percent.TextSize = 16
percent.Font = Enum.Font.GothamBold
percent.TextXAlignment = Enum.TextXAlignment.Left
percent.Parent = main

--// STATUS
local status = Instance.new("TextLabel")
status.Size = UDim2.new(1, -50, 0, 25)
status.Position = UDim2.new(0, 25, 0, 175)
status.BackgroundTransparency = 1
status.Text = "Initializing RNG..."
status.TextColor3 = Color3.fromRGB(145, 140, 160)
status.TextSize = 13
status.Font = Enum.Font.Gotham
status.TextXAlignment = Enum.TextXAlignment.Left
status.Parent = main

--// LOADING
task.spawn(function()
	for i = 1, 98 do

		local delayTime

		--// 1-20% FAST
		if i <= 20 then
			delayTime = 0.035
			status.Text = "Initializing RNG..."

		--// 20-50% EXTREMELY SLOW
		elseif i <= 50 then
			delayTime = 1.5 + ((i - 20) * 0.15)
			status.Text = "Calculating luck..."

		--// 50-80%
		elseif i <= 80 then
			delayTime = 0.15
			status.Text = "Boosting luck..."

		--// 80-90%
		elseif i <= 90 then
			delayTime = 0.25
			status.Text = "Searching lucky blocks..."

		--// 90-98%
		else
			delayTime = 0.55
			status.Text = "Optimizing RNG..."
		end

		percent.Text = i .. "%"

		TweenService:Create(
			bar,
			TweenInfo.new(
				delayTime,
				Enum.EasingStyle.Linear
			),
			{
				Size = UDim2.new(i / 100, 0, 1, 0)
			}
		):Play()

		task.wait(delayTime)
	end

	percent.Text = "98%"
	status.Text = "Almost ready..."

	--// STAYS AT 98%
end)
