--==================================================
-- ANIMATE PROGRESS
--==================================================

local currentValue = 0

local function animateTo(target, duration)
	local startValue = currentValue
	local startTime = os.clock()

	local progressTween = tween(
		progress,
		duration,
		{
			Size = UDim2.new(target / 100, 0, 1, 0),
		},
		Enum.EasingStyle.Quart,
		Enum.EasingDirection.Out
	)

	while gui.Parent and os.clock() - startTime < duration do
		local elapsed = os.clock() - startTime
		local alpha = math.clamp(elapsed / duration, 0, 1)

		-- Smooth cubic ease
		local eased = 1 - (1 - alpha)^3

		local value = startValue + (target - startValue) * eased

		currentValue = value

		percent.Text = string.format("%d%%", math.floor(value))

		updateStatus(value)

		RunService.Heartbeat:Wait()
	end

	currentValue = target

	percent.Text = target .. "%"
	updateStatus(target)

	progressTween.Completed:Wait()
end

