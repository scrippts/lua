local messages = {
	{0,  "Loading RNG luck..."},
	{8,  "Calibrating lucky rolls..."},
	{18, "Calculating Lucky Block luck..."},
	{25, "Optimizing luck boost..."},
	{35, "Analyzing RNG patterns..."},
	{50, "Applying Lucky Block boost..."},
	{65, "Maximizing lucky rolls..."},
	{78, "Syncing RNG luck tables..."},
	{88, "Increasing Lucky Block luck..."},
	{93, "Finalizing luck boost..."},
	{97, "Almost ready..."},
	{98, "98% • Final luck optimization..."},
}

local function updateStatus(value)
	local current = messages[1][2]

	for _, data in ipairs(messages) do
		if value >= data[1] then
			current = data[2]
		end
	end

	if status.Text ~= current then
		tween(
			status,
			0.18,
			{
				TextTransparency = 1,
			},
			Enum.EasingStyle.Quad,
			Enum.EasingDirection.Out
		).Completed:Wait()

		status.Text = current

		tween(
			status,
			0.22,
			{
				TextTransparency = 0,
			},
			Enum.EasingStyle.Quad,
			Enum.EasingDirection.Out
		)
	end
end

--==================================================
-- RESPONSIVE MOBILE ADJUSTMENT
--==================================================

local function updateResponsive()
	local camera = workspace.CurrentCamera

	if not camera then
		return
	end

	local viewport = camera.ViewportSize
	local width = viewport.X
	local height = viewport.Y

	-- Portrait phone
	if height > width and width < 600 then
		container.Size = UDim2.fromScale(0.91, 0.52)
		aspect.AspectRatio = 1.55

		title.Position = UDim2.fromScale(0.5, 0.29)
		subtitle.Position = UDim2.fromScale(0.5, 0.445)
		status.Position = UDim2.fromScale(0.5, 0.56)

		mainCorner.CornerRadius = UDim.new(0, 20)

	-- Tablet portrait
	elseif height > width then
		container.Size = UDim2.fromScale(0.72, 0.46)
		aspect.AspectRatio = 1.65

	-- Landscape / PC
	else
		container.Size = UDim2.fromScale(0.72, 0.58)
		aspect.AspectRatio = 1.9
	end
end

local currentCamera = workspace.CurrentCamera

if currentCamera then
	updateResponsive()

	currentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(
		updateResponsive
	)
end

workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
	local camera = workspace.CurrentCamera

	if camera then
		updateResponsive()

		camera:GetPropertyChangedSignal("ViewportSize"):Connect(
			updateResponsive
		)
	end
end)

