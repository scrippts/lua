--==================================================
-- MESSAGES
--==================================================

local messages = {
	{0,  "Loading RNG luck..."},
	{8,  "Calibrating lucky rolls..."},
	{18, "Calculating Lucky Block luck..."},
	{25, "Optimizing luck boost..."},
	{35, "Analyzing RNG patterns..."},
	{50, "Applying Lucky Block boost..."},
	{65, "Maximizing lucky rolls..."},
	{78, "Syncing RNG luck tables..."},
	{88, "Increasing Lucky Block luck..."},
	{93, "Finalizing luck boost..."},
	{97, "Almost ready..."},
	{98, "98% • Final luck optimization..."},
}

local currentValue = 0
local lastMessage = ""

local function updateText(value)
	local message = messages[1][2]

	for _, data in ipairs(messages) do
		if value >= data[1] then
			message = data[2]
		end
	end

	-- IMPORTANT:
	-- Only change Text when the message actually changes.
	if message ~= lastMessage then
		lastMessage = message
		status.Text = message
	end
end

--==================================================
-- SMOOTH PROGRESS
--==================================================

local function animateTo(target, duration)

	local start = currentValue

	local tween = TweenService:Create(
		bar,
		TweenInfo.new(
			duration,
			Enum.EasingStyle.Linear,
			Enum.EasingDirection.Out
		),
		{
			Size = UDim2.new(
				target / 100,
				0,
				1,
				0
			)
		}
	)

	tween:Play()

	local startTime = os.clock()
	local lastUpdate = -1

	while gui.Parent do

		local elapsed = os.clock() - startTime
		local alpha = math.clamp(
			elapsed / duration,
			0,
			1
		)

		currentValue =
			start +
			(target - start) * alpha

		local displayValue =
			math.floor(currentValue)

		-- Update only when percentage changes
		if displayValue ~= lastUpdate then

			lastUpdate = displayValue

			percent.Text =
				displayValue .. "%"

			updateText(currentValue)
		end

		if alpha >= 1 then
			break
		end

		-- 20 updates/sec is more than enough for text
		task.wait(0.05)
	end

	currentValue = target
	percent.Text = target .. "%"
	updateText(target)

	tween.Completed:Wait()
end

