	title.TextColor3 = C.WHITE
	title.TextSize = 14
	title.Font = Enum.Font.GothamBold
	title.TextXAlignment = Enum.TextXAlignment.Left
	title.Parent = top

	local subtitle = Instance.new("TextLabel")
	subtitle.Position = UDim2.new(0, 55, 0, 28)
	subtitle.Size = UDim2.new(1, -65, 0, 14)
	subtitle.BackgroundTransparency = 1
	subtitle.Text = config.Subtitle
	subtitle.TextColor3 = config.Accent
	subtitle.TextSize = 8
	subtitle.Font = Enum.Font.GothamBold
	subtitle.TextXAlignment = Enum.TextXAlignment.Left
	subtitle.Parent = top

	--==================================================--
	-- CLOSE
	--==================================================--

	local close = Instance.new("TextButton")
	close.Position = UDim2.new(1, -39, 0, 13)
	close.Size = UDim2.new(0, 27, 0, 27)
	close.BackgroundColor3 = Color3.fromRGB(26, 33, 47)
	close.Text = "×"
	close.TextColor3 = C.MUTED
	close.TextSize = 17
	close.Font = Enum.Font.GothamBold
	close.AutoButtonColor = false
	close.Parent = top

	Corner(close, 8)

	close.MouseEnter:Connect(function()

		Tween(close, .15, {
			BackgroundColor3 = C.RED,
			TextColor3 = C.WHITE
		})

	end)

	close.MouseLeave:Connect(function()

		Tween(close, .15, {
			BackgroundColor3 = Color3.fromRGB(26, 33, 47),
			TextColor3 = C.MUTED
		})

	end)

	close.MouseButton1Click:Connect(function()

		Tween(
			card,
			.3,
			{
				Size = UDim2.new(0, 0, 0, 0)
			},
			Enum.EasingStyle.Back,
			Enum.EasingDirection.In
		)

		task.wait(.3)

		card.Visible = false

	end)

	--==================================================--
	-- STATUS
	--==================================================--

	local statusDot = Instance.new("Frame")
	statusDot.Position = UDim2.new(0, 16, 0, 69)
	statusDot.Size = UDim2.new(0, 7, 0, 7)
	statusDot.BackgroundColor3 = C.MUTED
	statusDot.BorderSizePixel = 0
	statusDot.Parent = card

	Corner(statusDot, 10)

	local status = Instance.new("TextLabel")
	status.Position = UDim2.new(0, 29, 0, 64)
	status.Size = UDim2.new(1, -45, 0, 17)
	status.BackgroundTransparency = 1
	status.Text = config.OffText
	status.TextColor3 = C.MUTED
	status.TextSize = 9
	status.Font = Enum.Font.GothamSemibold
	status.TextXAlignment = Enum.TextXAlignment.Left
	status.Parent = card

	--==================================================--
	-- BUTTON
	--==================================================--

	local button = Instance.new("TextButton")
	button.Position = UDim2.new(0, 14, 1, -53)
	button.Size = UDim2.new(1, -28, 0, 39)
	button.BackgroundColor3 = config.Accent
	button.BorderSizePixel = 0
	button.Text = config.OffButton
	button.TextColor3 = C.WHITE
	button.TextSize = 11
	button.Font = Enum.Font.GothamBold
	button.AutoButtonColor = false
	button.Parent = card

	Corner(button, 11)

	Gradient(button, {
		ColorSequenceKeypoint.new(0, config.Accent),
		ColorSequenceKeypoint.new(1, config.Accent2)
	}, 0)

	--==================================================--
	-- LOADING
	--==================================================--

	local loading, spinner, loadingTitle, loadingSub, bar =
		CreateCardLoading(card, config.Accent)

	local enabled = false
	local busy = false

	--==================================================--
	-- BUTTON HOVER
	--==================================================--

	button.MouseEnter:Connect(function()

		if busy then
			return
		end

		Tween(button, .18, {
			Position = UDim2.new(0, 11, 1, -55),
			Size = UDim2.new(1, -22, 0, 42)
		}, Enum.EasingStyle.Sine)

	end)

	button.MouseLeave:Connect(function()

		Tween(button, .18, {
			Position = UDim2.new(0, 14, 1, -53),
			Size = UDim2.new(1, -28, 0, 39)
		}, Enum.EasingStyle.Sine)

	end)

	--==================================================--
	-- CLICK
	--==================================================--

	button.MouseButton1Click:Connect(function()

		if busy then
			return
		end

		busy = true
		loading.Visible = true
		bar.Size = UDim2.new(0, 0, 1, 0)

		if enabled then

			loadingTitle.Text = "DEACTIVATING"
			loadingSub.Text = config.LoadOff

		else

			loadingTitle.Text = "ACTIVATING"
			loadingSub.Text = config.LoadOn

		end

		Tween(
			bar,
			.75,
			{
				Size = UDim2.new(1, 0, 1, 0)
			},
			Enum.EasingStyle.Quint
		)

		task.spawn(function()

			local start = tick()

			while loading.Visible and tick() - start < .85 do

				spinner.Rotation += 25

				task.wait(.05)

			end

			spinner.Rotation = 0

		end)

		task.wait(.82)

		enabled = not enabled

		if enabled then

			status.Text = config.OnText
			status.TextColor3 = config.Accent
			statusDot.BackgroundColor3 = config.Accent

			button.Text = config.OnButton

			Tween(button, .25, {
				BackgroundColor3 = C.GREEN
			}, Enum.EasingStyle.Sine)

			Tween(statusDot, .2, {
				Size = UDim2.new(0, 10, 0, 10)
			}, Enum.EasingStyle.Sine)

			task.wait(.1)

			Tween(statusDot, .2, {
				Size = UDim2.new(0, 7, 0, 7)
			}, Enum.EasingStyle.Sine)

		else

			status.Text = config.OffText
			status.TextColor3 = C.MUTED
			statusDot.BackgroundColor3 = C.MUTED

			button.Text = config.OffButton

			Tween(button, .25, {
				BackgroundColor3 = config.Accent
			}, Enum.EasingStyle.Sine)

		end

		loading.Visible = false
		busy = false

	end)

	--==================================================--
	-- DRAG
	--==================================================--

	MakeDraggable(top, card)

	return card
end

