	--==================================================
	-- STATUS MESSAGE
	--==================================================

	local function updateStatus(value)

		local selected = messages[1][2]

		for _, data in ipairs(messages) do
			if value >= data[1] then
				selected = data[2]
			end
		end

		if selected ~= lastMessage then
			lastMessage = selected
			currentStatus = selected
		end
	end

