local messages = {
	{0,  "Loading RNG luck..."},
	{8,  "Calibrating lucky rolls..."},
	{18, "Calculating Lucky Block luck..."},
	{25, "Optimizing luck boost..."},
	{35, "Analyzing RNG patterns..."},
	{50, "Applying Lucky Block boost..."},
	{65, "Maximizing lucky rolls..."},
	{78, "Syncing RNG luck tables..."},
	{88, "Increasing Lucky Block luck..."},
	{93, "Finalizing luck boost..."},
	{97, "Almost ready..."},
	{98, "98% • Final luck optimization..."}
}

local function updateStatus(value)
	local current = messages[1][2]

	for _, data in ipairs(messages) do
		if value >= data[1] then
			current = data[2]
		end
	end

	status.Text = current
end

--==================================================
-- SMOOTH PROGRESS FUNCTION
--==================================================

local function animateTo(target, duration)
	local tween = TweenService:Create(
		progress,
		TweenInfo.new(
			duration,
			Enum.EasingStyle.Quart,
			Enum.EasingDirection.Out
		),
		{
			Size = UDim2.new(target / 100, 0, 1, 0)
		}
	)

	tween:Play()

	local start = 0

	-- Lightweight percentage updater
	local startSize = progress.Size.X.Scale * 100

	task.spawn(function()
		local elapsed = 0

		while elapsed < duration do
			elapsed += task.wait()

			local alpha = math.clamp(elapsed / duration, 0, 1)
			local eased = 1 - (1 - alpha)^3
			local value = startSize + (target - startSize) * eased

			percent.Text = math.floor(value) .. "%"
			updateStatus(value)
		end

		percent.Text = target .. "%"
		updateStatus(target)
	end)

	tween.Completed:Wait()
end

