		if index > #dotStates then 
			index = 1 
		end 
 
		task.wait(0.35) 
	end 
end) 
 
--// LOADING 
task.spawn(function() 
 
	for i = 1, 98 do 
 
		local delayTime 
 
		--// 1-20% 
		if i <= 20 then 
 
			delayTime = 0.035 
 
			action.Text = "SCANNING EGGS" 
			status.Text = "Preparing Auto Steal Eggs..." 
 
		--// 20-50% VERY SLOW 
		elseif i <= 50 then 
 
			delayTime = 1.5 + ((i - 20) * 0.15) 
 
			action.Text = "SELECTING BEST EGG" 
			status.Text = "Analyzing Auto Steal..." 
 
		--// 50-80% 
		elseif i <= 80 then 
 
			delayTime = 0.15 
 
			action.Text = "PROCESSING EGGS " 
			status.Text = "Combining the best attributes..." 
 
		--// 80-90% 
		elseif i <= 90 then 
 
			delayTime = 0.25 
 
			action.Text = "SELECTING BEST EGG" 
			status.Text = "Filtering optimal results..." 
 
		--// 90-98% 
		else 
 
			delayTime = 0.55 
 
			action.Text = "OPTIMIZING EGG SCRIPT" 
			status.Text = "Finalizing the EGGS..." 
 
		end 
 
		percent.Text = i .. "%" 
 
		TweenService:Create( 
			bar, 
			TweenInfo.new( 
				delayTime, 
				Enum.EasingStyle.Linear 
			), 
			{ 
				Size = UDim2.new(i / 100, 0, 1, 0) 
			} 
		):Play() 
 
		task.wait(delayTime) 
	end 
 
	--// STAYS AT 98% 
	percent.Text = "98%" 
	action.Text = "AUTO STEAL LOADING.." 
	status.Text = "Almost ready..." 
	footer.Text = "Waiting for final initialization..." 
 
end) 
