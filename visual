--==================================================
-- MESSAGES
--==================================================

local messages = {
	{0,  "Loading RNG luck"},
	{8,  "Calibrating lucky rolls"},
	{18, "Calculating Lucky Block luck"},
	{25, "Optimizing luck boost"},
	{35, "Analyzing RNG patterns"},
	{50, "Applying Lucky Block boost"},
	{65, "Maximizing lucky rolls"},
	{78, "Syncing RNG luck tables"},
	{88, "Increasing Lucky Block luck"},
	{93, "Finalizing luck boost"},
	{97, "Almost ready"},
}

local currentValue = 0
local currentStatus = messages[1][2]

--==================================================
-- STATUS UPDATE
--==================================================

local function updateStatus(value)

	for i = #messages, 1, -1 do

		if value >= messages[i][1] then
			currentStatus = messages[i][2]
			break
		end

	end

end

--==================================================
-- DOT ANIMATION
--==================================================

task.spawn(function()

	local dots = 0

	while gui.Parent and currentValue < 98 do

		dots = (dots + 1) % 4

		status.Text =
			currentStatus ..
			string.rep(".", dots)

		task.wait(0.45)

	end

end)

--==================================================
-- PROGRESS
--==================================================

local function animateProgress(target, duration)

	local start = currentValue
	local startTime = os.clock()

	-- Smooth bar animation
	TweenService:Create(
		bar,
		TweenInfo.new(
			duration,
			Enum.EasingStyle.Linear,
			Enum.EasingDirection.Out
		),
		{
			Size = UDim2.new(target / 100, 0, 1, 0)
		}
	):Play()

	while gui.Parent do

		local elapsed = os.clock() - startTime
		local alpha = math.clamp(elapsed / duration, 0, 1)

		currentValue =
			start + ((target - start) * alpha)

		percent.Text =
			math.floor(currentValue) .. "%"

		updateStatus(currentValue)

		if alpha >= 1 then
			break
		end

		task.wait(0.05)

	end

	currentValue = target
	percent.Text = target .. "%"

end

--==================================================
-- LOADING SEQUENCE
--==================================================

task.spawn(function()

	animateProgress(20, 2.5)
	animateProgress(40, 3)
	animateProgress(60, 3)
	animateProgress(80, 3.5)
	animateProgress(90, 3)
	animateProgress(95, 3)
	animateProgress(97, 2.5)
	animateProgress(98, 4)

	--================================================
	-- 98% = PERMANENT
	--================================================

	currentValue = 98

	percent.Text = "98%"
	status.Text = "98% • Final luck optimization..."
	bottom.Text = "LUCK ENGINE READY • 98%"

	while gui.Parent do
