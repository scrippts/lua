		end
	end)

	--==================================================
	-- SMOOTH PROGRESS
	--==================================================

	local function animateProgress(target, duration)

		local startValue = currentValue
		local startTime = os.clock()

		local progressTween = TweenService:Create(
			bar,
			TweenInfo.new(
				duration,
				Enum.EasingStyle.Linear,
				Enum.EasingDirection.Out
			),
			{
				Size = UDim2.new(
					target / 100,
					0,
					1,
					0
				)
			}
		)

		progressTween:Play()

		local lastDisplayed = math.floor(startValue)

		while gui.Parent do

			local elapsed = os.clock() - startTime

			local alpha = math.clamp(
				elapsed / duration,
				0,
				1
			)

			currentValue =
				startValue +
				(target - startValue) * alpha

			local displayed =
				math.floor(currentValue)

			if displayed ~= lastDisplayed then

				lastDisplayed = displayed

				percent.Text =
					displayed .. "%"

				updateStatus(currentValue)
			end

			if alpha >= 1 then
				break
			end

			task.wait(0.03)
		end

		currentValue = target

		percent.Text = target .. "%"

		updateStatus(target)

		progressTween.Completed:Wait()
	end

